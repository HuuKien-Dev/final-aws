# Địa chỉ backend mà CONTAINER FRONTEND có thể truy cập.
# Cùng Docker Compose: dùng tên service http://backend:8000
# Khác máy/cloud: ví dụ http://10.0.2.15:8000 hoặc https://api.example.com
BACKEND_URL=http://backend:8000

# Địa chỉ public chính xác mà người dùng mở frontend.
APP_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000
COOKIE_SECURE=false

# PostgreSQL cloud. Mật khẩu có ký tự đặc biệt phải được URL encode.
# Với database cloud, thường cần thêm ?ssl=require.
DATABASE_URL=postgresql://english_app:change-me@database.example.com:5432/english_app?ssl=require

# Ảnh, logo và audio: local dùng assets trong backend image; s3 dùng bucket private.
ASSET_STORAGE=local
S3_ASSET_BUCKET=
S3_IMAGE_PREFIX=media
S3_AUDIO_PREFIX=audio
AWS_REGION=ap-southeast-1

# AI là tùy chọn.
AI_PROVIDER=openai
AI_API_KEY=
AI_DAILY_LIMIT=30
AI_AUDIO_ENABLED=false
