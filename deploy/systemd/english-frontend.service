[Unit]
Description=English learning Next.js
After=network-online.target
Wants=network-online.target
[Service]
User=english
Group=english
WorkingDirectory=/opt/english/current/frontend
EnvironmentFile=/etc/english/frontend.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node /opt/english/current/frontend/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
