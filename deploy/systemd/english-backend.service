[Unit]
Description=English learning API
After=network-online.target
Wants=network-online.target
[Service]
User=english
Group=english
WorkingDirectory=/opt/english/current/backend
EnvironmentFile=/etc/english/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/english/current/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-proxy-headers --timeout-keep-alive 130
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
