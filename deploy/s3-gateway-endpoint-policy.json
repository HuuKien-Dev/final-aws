{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackendReadApplicationAssets",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/media/*",
        "arn:aws:s3:::BUCKET_NAME/audio/*"
      ]
    }
  ]
}
