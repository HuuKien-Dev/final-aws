# Địa chỉ public chính xác mà người dùng mở frontend.
APP_ORIGIN=https://learn.example.com
BACKEND_PORT=8000
COOKIE_SECURE=true

# PostgreSQL cloud. URL-encode ký tự đặc biệt trong mật khẩu.
DATABASE_URL=postgresql://english_app:change-me@database.example.com:5432/english_app?ssl=require

# Tài nguyên private trên S3.
ASSET_STORAGE=s3
S3_ASSET_BUCKET=your-private-bucket
S3_IMAGE_PREFIX=media
S3_AUDIO_PREFIX=audio
AWS_REGION=ap-southeast-1

# AI là tùy chọn. Nhà cung cấp: openai | deepseek | gemini | anthropic | compatible | colab | bedrock
AI_PROVIDER=openai
AI_API_KEY=
# Model/endpoint riêng; để trống để dùng mặc định của nhà cung cấp (bắt buộc AI_MODEL với bedrock).
AI_MODEL=
AI_BASE_URL=
# Amazon Bedrock: AI_PROVIDER=bedrock, AI_MODEL=<model/inference profile ID>,
# để trống AI_API_KEY để dùng IAM Role (deploy/iam-backend-bedrock-invoke.json).
BEDROCK_REGION=
# Bedrock: giới hạn token đầu ra; Claude 5.x nên đặt 16000 (gồm cả phần suy luận).
AI_MAX_TOKENS=
AI_DAILY_LIMIT=30
AI_AUDIO_ENABLED=false

