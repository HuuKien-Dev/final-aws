# Địa chỉ public chính xác mà người dùng mở frontend.
APP_ORIGIN=https://learn.example.com
BACKEND_PORT=8000
COOKIE_SECURE=true

# PostgreSQL cloud. URL-encode ký tự đặc biệt trong mật khẩu.
DATABASE_URL=postgresql://english_app:change-me@database.example.com:5432/english_app?ssl=require

# Tài nguyên private trên S3.
ASSET_STORAGE=s3
S3_ASSET_BUCKET=your-private-bucket
S3_IMAGE_PREFIX=media
S3_AUDIO_PREFIX=audio
AWS_REGION=ap-southeast-1

# AI là tùy chọn.
AI_PROVIDER=openai
AI_API_KEY=
AI_DAILY_LIMIT=30
AI_AUDIO_ENABLED=false

