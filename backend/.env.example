# Local development only; use a non-superuser role.
DATABASE_URL=postgresql://english_app:change-local-password@127.0.0.1:5432/english_app
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# AWS: APP_ORIGIN=https://english.example.com ; COOKIE_SECURE=true
# AWS DATABASE_URL must include ?ssl=require; URL-encode password special characters.

# Exactly ONE AI provider is active at a time; credentials never go to the browser.
# openai | deepseek | gemini | anthropic | compatible | colab | bedrock
AI_PROVIDER=openai
AI_API_KEY=
# Empty overrides are not defaults: omit AI_BASE_URL / AI_MODEL to use provider defaults.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30
# Enable only if this SAME provider offers OpenAI-compatible audio endpoints.
AI_AUDIO_ENABLED=false
# AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# AI_SPEECH_MODEL=gpt-4o-mini-tts

# Amazon Bedrock (Converse API — Claude, Nova, Llama, Mistral...):
# AI_PROVIDER=bedrock
# AI_MODEL=<model ID hoặc inference profile ID đã bật trong Bedrock console>
# BEDROCK_REGION=ap-southeast-1   # mặc định dùng AWS_REGION
# AI_MAX_TOKENS=16000             # Claude 5.x: suy luận dùng chung giới hạn này
# Để trống AI_API_KEY để dùng IAM Role của EC2/ECS (khuyến nghị),
# hoặc đặt AI_API_KEY=<Bedrock API key> để gọi bằng bearer token.
# AI_BASE_URL chỉ cần khi dùng VPC Interface Endpoint riêng cho bedrock-runtime.

# Images, logos and audio are served by backend endpoints; the S3 bucket stays private.
# local = read assets/ in the backend container; s3 = use the backend IAM role.
ASSET_STORAGE=local
S3_ASSET_BUCKET=
S3_IMAGE_PREFIX=media
S3_AUDIO_PREFIX=audio
AWS_REGION=ap-southeast-1
