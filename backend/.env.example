# Local development only; use a non-superuser role.
DATABASE_URL=postgresql://english_app:change-local-password@127.0.0.1:5432/english_app
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# AWS: APP_ORIGIN=https://english.example.com ; COOKIE_SECURE=true
# AWS DATABASE_URL must include ?ssl=require; URL-encode password special characters.

# Exactly ONE AI provider is active at a time; credentials never go to the browser.
# openai | deepseek | gemini | anthropic | compatible | colab
AI_PROVIDER=openai
AI_API_KEY=
# Empty overrides are not defaults: omit AI_BASE_URL / AI_MODEL to use provider defaults.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30
# Enable only if this SAME provider offers OpenAI-compatible audio endpoints.
AI_AUDIO_ENABLED=false
# AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# AI_SPEECH_MODEL=gpt-4o-mini-tts

# Social login; set an independent random secret of at least 32 characters.
# Callback: APP_ORIGIN/api/auth/oauth/google/callback (and /facebook/callback).
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v23.0

# Images are served by /api/picture-assets/{filename}; never by a public S3 URL.
# local = read assets/picture-vocabulary on development machine; s3 = IAM role on AWS.
PICTURE_ASSET_STORAGE=local
S3_IMAGE_BUCKET=
S3_IMAGE_PREFIX=media
